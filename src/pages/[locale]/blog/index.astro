---
import BlogLayout from '../../../layouts/BlogLayout.astro'
import { blogLanguageLinks, blogPath, formatPublicationDate, getBlogTopics } from '../../../marketing/blog'
import { blogCopy } from '../../../marketing/blogCopy'
import { marketingLocales } from '../../../marketing/config'

export const prerender = true

export async function getStaticPaths () {
  const topics = await getBlogTopics()
  const locales = marketingLocales.filter(locale => topics.some(topic => topic.posts.has(locale)))
  const languageLinks = blogLanguageLinks(locales)
  return locales.map(locale => ({
    params: { locale },
    props: {
      locale,
      languageLinks,
      posts: topics.flatMap(({ slug, publishedOn, posts }) => {
        const post = posts.get(locale)
        return post ? [{ slug, publishedOn, ...post.data }] : []
      }),
    },
  }))
}

const { locale, languageLinks, posts } = Astro.props
const copy = blogCopy[locale]
---

<BlogLayout {locale} title={copy.title} description={copy.description} path={blogPath(locale)} {languageLinks}>
  <ul class='blog-list' aria-label={copy.title}>
    {posts.map(({ slug, publishedOn, title, description }) => (
      <li>
        <a class='blog-post-link' href={blogPath(locale, slug)}>
          {publishedOn && <time datetime={publishedOn}>{formatPublicationDate(locale, publishedOn)}</time>}
          <h2>{title}</h2>
          <p>{description}</p>
        </a>
      </li>
    ))}
  </ul>
</BlogLayout>
