---
import { render } from 'astro:content'
import BlogLayout from '../../../layouts/BlogLayout.astro'
import { blogLanguageLinks, blogPath, getBlogTopics } from '../../../marketing/blog'
import { blogCopy } from '../../../marketing/blogCopy'
import { localizedAppPath, marketingLocales } from '../../../marketing/config'

export const prerender = true

export async function getStaticPaths () {
  const topics = await getBlogTopics()
  return topics.flatMap(({ slug, publishedOn, posts }) => {
    const languageLinks = blogLanguageLinks(marketingLocales.filter(locale => posts.has(locale)), slug)
    return [...posts].map(([locale, post]) => ({
      params: { locale, slug },
      props: {
        locale, slug, post, publishedOn, languageLinks,
      },
    }))
  })
}

const {
  locale, slug, post, publishedOn, languageLinks,
} = Astro.props
const { title, description } = post.data
const { Content } = await render(post)
---

<BlogLayout {locale} {title} {description} path={blogPath(locale, slug)} {languageLinks} article={{ publishedOn }}>
  <div class='blog-prose'>
    <Content />
  </div>
  <div class='blog-actions'>
    <a href={localizedAppPath(locale, '/meetings/create')}>{blogCopy[locale].createPoll}</a>
  </div>
</BlogLayout>
