---
import Layout from '../../layouts/Layout.astro'
import { getLocaleFromAstroRequest, getTranslations, defaultLocale } from '../../i18n'
import SearchMeeting from '../../components/SearchMeeting'

const locale = getLocaleFromAstroRequest(Astro.cookies, Astro.request.headers, Astro.url.searchParams.get('lang')) || defaultLocale
const t = getTranslations(locale);
---

<Layout locale={locale}>
  <main>
    <h1 data-i18n='search.title'>{t('search.title')}</h1>
    <p data-i18n='search.description'>{t('search.description')}</p>
    <div class='search-meeting'>
      <SearchMeeting client:only='react' />
    </div>
  </main>
</Layout>

<style lang='scss'>
  @use '../../styles/variables.scss' as *;
  main {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    margin-bottom: 50px;
  }
  h1 {
    margin-bottom: $spacing-sm;
  }
  p {
    margin-bottom: $spacing-lg;
    word-break: var(--text-word-break, normal);
  }

  .search-meeting {
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: $spacing-md;
  }
</style>
