---
import Layout from '../../../layouts/Layout.astro';
import { getLocaleFromAstroRequest, getTranslations, defaultLocale } from '../../../i18n';
import { meetings } from '../../../services/meetings';
import type { get_meetings_$meetingCode_response } from '../../../services/meetings';
import Avatar from '../../../components/Avatar/Avatar';
import ResultButtons from '../../../components/ResultPage/ResultButtons';
import ResultContent from '../../../components/ResultPage/ResultContent';
import { formatDate, formatTime } from '../../../utils/time';

const locale = getLocaleFromAstroRequest(Astro.cookies, Astro.request.headers) || defaultLocale;
const t = getTranslations(locale);

const meetingCode = Astro.params.meetingCode as string;
let data: get_meetings_$meetingCode_response['data'] | null = null;
try {
  const response = await meetings.$meetingCode.get(meetingCode);
  data = response.data;
} catch (error) {
  return Astro.redirect('/404',);
}

// SEO 메타데이터 설정
const siteUrl = Astro.site?.href || 'https://time2gather.org/';
const isConfirmed = !!data.meeting.confirmedDate;
const confirmedDetails = isConfirmed
  ? [
      formatDate(data.meeting.confirmedDate!, locale),
      formatTime(
        data.meeting.confirmedTime ?? 'ALL_DAY',
        locale,
        t('meeting.confirmDialog.allDay'),
      ),
      data.locationVote?.enabled
        ? data.locationVote.confirmedLocation?.name ?? t('meeting.result.kakaoShare.locationPending')
        : null,
    ].filter((detail): detail is string => !!detail)
  : [];
const meetingTitle = t(
  isConfirmed ? 'meta.pages.result.confirmedTitle' : 'meta.pages.result.title',
  { title: data.meeting.title },
);
const meetingDescription = isConfirmed
  ? t('meta.pages.result.confirmedDescription', { details: confirmedDetails.join(' · ') })
  : t('meeting.result.kakaoShare.description');
const ogImage = new URL('/time2gather-share.png?v=2', siteUrl).href;

---
<Layout
  title={meetingTitle}
  description={meetingDescription}
  ogImage={ogImage}
  ogType="website"
>
  <main>
    <h1>{data.meeting.title}</h1>
    <p>{data.meeting.description}</p>
    <div class="host">
      <Avatar
        client:only="react"
        src={data.meeting.host.profileImageUrl}
        name={data.meeting.host.username}
      />
      <span>{data.meeting.host.username}</span>
    </div>
    <div class="report">
      <ResultContent
        client:only="react"
        meetingData={data}
      />
    </div>
    <div class="button-container">
      <ResultButtons client:only="react" data={data} />
    </div>
  </main>
</Layout>

<style lang="scss">
  @use "../../../styles/variables.scss" as *;
  p {
    word-break: keep-all;
    color: $c-black;
  }
  h1 {
    margin: 0 0 $spacing-sm;
    font-size: $font-size-3xl;
    line-height: 1.35;

    @media (max-width: 699px) {
      font-size: $font-size-2xl;
    }
  }
  main > p {
    margin: 0 0 $spacing-base;
    color: $c-gray-darkest;
    font-size: $font-size-base;
    line-height: $line-height-normal;
  }
  main {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    padding-bottom: $spacing-xl;
  }

  .host {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .report {
    margin-top: $spacing-lg;

    @media (max-width: 699px) {
      margin-top: $spacing-base;
    }
  }

  .button-container {
    margin: $spacing-xl 0 0;
    display: flex;
    flex-direction: column;
    gap: $spacing-sm;
  }
</style>
