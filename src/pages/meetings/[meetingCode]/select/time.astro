---
import Layout from '../../../../layouts/Layout.astro';
import { getLocaleFromAstroRequest, getTranslations, defaultLocale } from '../../../../i18n';
import { meetings } from '../../../../services/meetings';
import type { get_meetings_$meetingCode_response } from '../../../../services/meetings';
import AnonymousTimeSelectPage from '../../../../components/SelectPage/AnonymousTimeSelectPage';

const locale = getLocaleFromAstroRequest(Astro.cookies, Astro.request.headers, Astro.url.searchParams.get('lang')) || defaultLocale;
const t = getTranslations(locale);

const meetingCode = Astro.params.meetingCode as string;
let data: get_meetings_$meetingCode_response['data'] | null = null;
try {
  const response = await meetings.$meetingCode.get(meetingCode);
  data = response.data;
} catch (error) {
  return Astro.redirect(`/404?lang=${locale}`);
}
---
<Layout>
  <main>
    <h1>{data.meeting.title}</h1>
    <AnonymousTimeSelectPage client:only="react" meetingCode={meetingCode} initialData={data} />
  </main>
</Layout>

<style lang="scss">
  @use "../../../../styles/variables.scss" as *;
  p {
    word-break: var(--text-word-break, normal);
    color: $c-black;
  }
  main {
    width: 100%;
    max-width: 600px;

    @media (min-width: 700px) {
      max-width: 1000px;
    }
    margin: 0 auto;
    padding-bottom: 80px;

    @media (max-width: 699px) {
      padding-bottom: $spacing-xl;
    }
  }

  h1 {
    margin: 0 0 $spacing-base;
    color: $c-black;
    font-size: $font-size-2xl;
    line-height: $line-height-tight;
    word-break: var(--text-word-break, normal);

    @media (max-width: 699px) {
      font-size: $font-size-xl;
    }
  }
</style>
