---
import Analytics from '../components/Analytics.astro'
import '../styles/typography.scss'
import '../styles/site-header.scss'
import LocaleBootstrap from '../components/LocaleBootstrap.astro'
import LocaleFonts from '../components/LocaleFonts.astro'
import PerformanceMonitoring from '../components/PerformanceMonitoring.astro'
import { defaultLocale, openGraphLocales } from '../i18n/config'
import { getTranslations } from '../i18n'
import {
  localeMeta, localizedAppPath, localizedPath, marketingLocales, type MarketingLocale, type MarketingPage,
} from '../marketing/config'
import { marketingCopy } from '../marketing/copy'
import { blogPath, getBlogTopics, type BlogLanguageLink } from '../marketing/blog'
import { blogCopy } from '../marketing/blogCopy'

interface MarketingProps {
  locale: MarketingLocale
  page: MarketingPage
  title?: string
  description?: string
}

interface BlogProps {
  locale: MarketingLocale
  page: 'blog'
  title: string
  description: string
  canonicalPath: string
  languageLinks: BlogLanguageLink[]
  article?: { headline: string, publishedOn?: string }
}

type Props = MarketingProps | BlogProps

const props = Astro.props
const { locale, page } = props
const blog = props.page === 'blog' ? props : null
const marketingPage = page === 'blog' ? 'home' : page
const previewBlog = !!blog && import.meta.env.DEV
const showBlogLink = page === 'home' && (await getBlogTopics()).some(topic => topic.posts.has(locale))
const copy = marketingCopy[locale]
const t = getTranslations(locale)
const siteUrl = Astro.site?.href || 'https://time2gather.org/'
const canonicalPath = blog?.canonicalPath || localizedPath(locale, marketingPage)
const canonical = new URL(canonicalPath, siteUrl).href
const title = props.title || (marketingPage === 'home' ? copy.metaTitle : `${copy[marketingPage].title} | Time2Gather`)
const description = props.description || (marketingPage === 'home' ? copy.metaDescription : copy[marketingPage].intro)
const ogImage = new URL('/share/brand-v2.png', siteUrl).href
const languageLinks = blog?.languageLinks ?? marketingLocales.map(language => ({
  locale: language, path: localizedPath(language, marketingPage),
}))
const localePaths = Object.fromEntries(languageLinks.map(({ locale: language, path }) => [language, path]))
// Nigerian Pidgin uses the ISO 639-3 code pcm, outside Google's hreflang language code format.
const alternateLinks = blog
  ? (locale === 'pcm' ? [] : languageLinks.filter(link => link.locale !== 'pcm'))
  : languageLinks
const defaultPath = blog
  ? (locale === 'pcm' ? undefined : localePaths[defaultLocale])
  : (marketingPage === 'home' ? '/' : `/${marketingPage}/`)
const pageType = page === 'about' ? 'AboutPage' : page === 'contact' ? 'ContactPage' : 'WebPage'

const organization = {
  '@type': 'Organization',
  '@id': new URL('/#organization', siteUrl).href,
  'name': 'Time2Gather',
  'url': siteUrl,
  'logo': new URL('/brand/logo.svg', siteUrl).href,
  'email': 'wlsdn3578@gmail.com',
}

const graph: Record<string, unknown>[] = [
  organization,
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', siteUrl).href,
    'name': 'Time2Gather',
    'url': siteUrl,
    'publisher': { '@id': organization['@id'] },
    'inLanguage': marketingLocales,
  },
  {
    '@type': pageType,
    '@id': `${canonical}#page`,
    'name': title,
    description,
    'url': canonical,
    'inLanguage': locale,
    'isPartOf': { '@id': new URL('/#website', siteUrl).href },
    'about': { '@id': organization['@id'] },
  },
]

if (page === 'home') {
  graph.push({
    '@type': 'WebApplication',
    '@id': new URL('/#application', siteUrl).href,
    'name': 'Time2Gather',
    'url': siteUrl,
    description,
    'applicationCategory': 'SchedulingApplication',
    'operatingSystem': 'All',
    'inLanguage': locale,
    'isAccessibleForFree': true,
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
    'featureList': ['Group scheduling', 'Date and time voting', 'Location voting', 'Calendar export', 'Anonymous participation'],
    'publisher': { '@id': organization['@id'] },
  })
  graph.push({
    '@type': 'FAQPage',
    'mainEntity': copy.faqs.map(item => ({
      '@type': 'Question',
      'name': item.title,
      'acceptedAnswer': { '@type': 'Answer', 'text': item.body },
    })),
  })
}

if (blog?.article?.publishedOn && !previewBlog) {
  graph.push({
    '@type': 'BlogPosting',
    '@id': `${canonical}#article`,
    'mainEntityOfPage': canonical,
    'headline': blog.article.headline,
    description,
    'datePublished': blog.article.publishedOn,
    'inLanguage': locale,
    'author': { '@id': organization['@id'] },
    'publisher': { '@id': organization['@id'] },
  })
}

const structuredData = { '@context': 'https://schema.org', '@graph': graph }
---

<!doctype html>
<html lang={locale} dir={localeMeta[locale].dir}>
  <head>
    <meta charset='UTF-8' />
    <LocaleFonts locale={locale} />
    <PerformanceMonitoring />
    {!blog && <LocaleBootstrap locale={locale} localePaths={localePaths} />}
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/png' sizes='192x192' href='/brand/icon-192.png' />
    <link rel='apple-touch-icon' sizes='180x180' href='/brand/apple-touch-icon.png' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='author' content='Time2Gather' />
    <meta name='robots' content={previewBlog ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel='canonical' href={canonical} />
    {alternateLinks.map(({ locale: language, path }) => (
      <link rel='alternate' hreflang={language} href={new URL(path, siteUrl).href} />
    ))}
    {defaultPath && <link rel='alternate' hreflang='x-default' href={new URL(defaultPath, siteUrl).href} />}

    <meta property='og:type' content={blog?.article ? 'article' : 'website'} />
    <meta property='og:url' content={canonical} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={ogImage} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content={title} />
    <meta property='og:locale' content={openGraphLocales[locale]} />
    <meta property='og:site_name' content='Time2Gather' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={ogImage} />
    <script type='application/ld+json' set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />

    <Analytics />
  </head>
  <body>
    <header class='t2g-site-header' data-site-header>
      <a class='t2g-site-header__brand' href={localizedPath(locale, 'home')} aria-label='Time2Gather'>
        <img src='/brand/icon-192.png' alt='' width='34' height='34' />
        <span>Time2Gather</span>
      </a>
      <nav class='t2g-site-header__nav' aria-label={copy.nav.home}>
        <a href={localizedAppPath(locale, '/my')}>{t('common.myMeetings')}</a>
        <a href={localizedAppPath(locale, '/meetings/search')}>{t('common.enterInvitationCode')}</a>
        <a href={localizedPath(locale, 'contact')}>{copy.nav.contact}</a>
      </nav>
      <details class='language-menu'>
        <summary class='t2g-site-header__locale' aria-label={copy.nav.language} title={localeMeta[locale].label}>
          <svg class='language-icon' xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
            <circle cx='12' cy='12' r='9' />
            <path d='M3 12h18M12 3a17 17 0 0 1 0 18 17 17 0 0 1 0-18Z' />
          </svg>
          <span class='language-current'>{localeMeta[locale].label}</span>
        </summary>
        <div class='language-list'>
          {languageLinks.map(({ locale: language, path }) => (
            <a
              href={path}
              data-marketing-locale={language}
              hreflang={language}
              lang={language}
              aria-current={language === locale ? 'page' : undefined}
            >
              {localeMeta[language].label}
            </a>
          ))}
        </div>
      </details>
      <details class='t2g-site-header__menu'>
        <summary aria-label={t('common.openMenu')}>
          <svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' aria-hidden='true'><path d='M4 6h16M4 12h16M4 18h16' /></svg>
        </summary>
        <nav class='t2g-site-header__menu-panel' aria-label={t('common.openMenu')}>
          <a href={localizedAppPath(locale, '/meetings/create')}>{t('common.createMeeting')}</a>
          <a href={localizedAppPath(locale, '/my')}>{t('common.myMeetings')}</a>
          <a href={localizedAppPath(locale, '/meetings/search')}>{t('common.enterInvitationCode')}</a>
          <a class='t2g-site-header__contact' href={localizedPath(locale, 'contact')}>{copy.nav.contact}</a>
        </nav>
      </details>
    </header>
    <script>
      import '../utils/siteHeader'
    </script>

    <script is:inline>
      document.querySelectorAll('[data-marketing-locale]').forEach((link) => {
        link.addEventListener('click', () => {
          const selectedLocale = link.getAttribute('data-marketing-locale')
          if (!selectedLocale) return

          try {
            const selectedAppLocale = selectedLocale
            window.localStorage.setItem('marketingLocale', selectedLocale)
            window.localStorage.setItem('locale', selectedAppLocale)
            const secure = window.location.protocol === 'https:' ? '; Secure' : ''
            document.cookie = `locale=${selectedAppLocale}; Path=/; Max-Age=31536000; SameSite=Lax${secure}`
          } catch {
            // The destination page still carries the selected language in its URL.
          }
        })
      })
    </script>

    <slot />

    <footer class='site-footer'>
      <div>
        <a class='footer-brand' href={localizedPath(locale, 'home')}>Time2Gather</a>
        <p>{copy.footer}</p>
      </div>
      <nav aria-label={copy.nav.terms}>
        {showBlogLink && <a class='footer-blog' href={blogPath(locale)}>{blogCopy[locale].title}</a>}
        <a href={localizedPath(locale, 'about')}>{copy.nav.about}</a>
        <a href={localizedPath(locale, 'contact')}>{copy.nav.contact}</a>
        <a href={localizedPath(locale, 'privacy')}>{copy.nav.privacy}</a>
        <a href={localizedPath(locale, 'terms')}>{copy.nav.terms}</a>
      </nav>
      <p class='copyright'>© 2026 Time2Gather</p>
    </footer>
  </body>
</html>

<style>
  :root { color-scheme: light; font-family: var(--font-ui, system-ui, sans-serif); }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body { margin: 0; color: #191f28; background: #fff; line-height: var(--font-body-line-height, 1.6); }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  .site-header { position: relative; z-index: 10; display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: 24px; width: min(1120px, calc(100% - 40px)); min-height: 72px; margin: 0 auto; }
  .brand, .footer-brand { display: inline-flex; align-items: center; gap: 10px; font-weight: var(--font-weight-brand); letter-spacing: -0.03em; }
  .brand { font-size: 20px; }
  .main-nav { display: flex; gap: 22px; color: #4e5968; font-size: 14px; font-weight: var(--font-weight-label); }
  .main-nav a:hover, .site-footer a:hover { color: #3182f6; }
  .my-meetings { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 10px 0; color: #333d4b; font-size: 14px; font-weight: var(--font-weight-label); line-height: 1.4; text-align: center; overflow-wrap: anywhere; }
  .my-meetings:hover { color: #1b64da; }
  .my-meetings:focus-visible { outline: 2px solid #3182f6; outline-offset: 3px; }
  .language-menu { position: relative; min-width: 0; }
  .language-icon { flex-shrink: 0; }
  .language-list { position: absolute; inset-inline-end: 0; top: calc(100% + 8px); display: grid; grid-template-columns: repeat(2, minmax(130px, 1fr)); gap: 3px; width: 294px; max-height: 360px; overflow: auto; padding: 8px; border: 1px solid #e5e8eb; border-radius: 16px; background: #fff; box-shadow: 0 16px 40px rgba(0, 27, 55, 0.12); }
  .language-list a { padding: 9px 10px; border-radius: 9px; color: #4e5968; font-size: 14px; }
  .language-list a:hover, .language-list a[aria-current="page"] { color: #1b64da; background: #edf6ff; }
  .site-footer { display: grid; grid-template-columns: 1.4fr 2fr auto; gap: 32px; align-items: start; width: min(1120px, calc(100% - 40px)); margin: 48px auto 0; padding: 32px 0 48px; border-top: 1px solid #e5e8eb; color: #6b7684; font-size: 14px; }
  .site-footer p { margin: 6px 0 0; }
  .site-footer nav { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .footer-blog { display: inline-flex; align-items: center; min-height: 44px; }
  .copyright { white-space: nowrap; }
  @media (max-width: 720px) {
    .site-header { grid-template-columns: minmax(0, 1fr) auto auto; gap: 10px; width: min(100% - 28px, 1120px); }
    .main-nav { display: none; }
    .my-meetings { max-width: 160px; }
    .language-list { position: fixed; inset-inline: 14px; top: 68px; width: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer { grid-template-columns: 1fr; width: calc(100% - 32px); margin-top: 32px; }
  }
  @media (max-width: 480px) {
    .site-header { grid-template-columns: auto minmax(0, 1fr) 44px; gap: 12px; width: calc(100% - 32px); }
    .brand { min-height: 44px; gap: 7px; font-size: 16px; white-space: nowrap; }
    .brand img { width: 28px; height: 28px; }
    .my-meetings { justify-self: end; font-size: 13px; }
  }
</style>
